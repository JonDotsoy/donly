{
  "name": "donly",
  "version": "0.0.33",
  "description": "DON (Directive Object Notation) - A human-readable data serialization format based on directives and subdirectives for configuration files, infrastructure definitions, and structured data",
  "keywords": [
    "don",
    "directive",
    "serialization",
    "parser",
    "config",
    "configuration",
    "data-format",
    "markup",
    "notation"
  ],
  "author": {
    "name": "Jonathan Delgado",
    "email": "hi@jon.soy",
    "url": "https://jon.soy"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JonDotsoy/don"
  },
  "homepage": "https://don.jon.soy/",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "donly": "./src/bin/donly.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./utils": "./src/utils.ts",
    "./encoder": "./src/directive-json.ts",
    "./decoder": "./src/directive-json.ts",
    "./load": "./src/load.ts",
    "./lint": "./src/lint/lint.ts",
    "./common/errors": "./src/common/errors.ts",
    "./find": "./src/find.ts",
    "./demo/http-proxy": "./src/demo/proxy/http-proxy.ts",
    "./demo/plugins/variables": "./src/demo/plugins/variables-plugin.ts",
    "./demo/plugins/resources": "./src/demo/plugins/resources-plugin.ts",
    "./plugins/scoped-variables": "./src/plugins/scoped-variables-plugin.ts"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "prepack": "npm run lint && npm run build",
    "build": "npm run build:esm && npm run build:assets",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:assets": "mkdir -p lib/esm/demo/proxy/certs && cp src/demo/proxy/certs/*.pem lib/esm/demo/proxy/certs/ && node scripts/build-lib-package-json.mjs",
    "clean": "rm -rf lib",
    "lint": "prettier --check .",
    "fmt": "prettier --write .",
    "test:types": "tsc -p tsconfig.types.json --noEmit",
    "update:docs": "npm run build && tmd README.md docs/specs/v1/spec.md docs/lint/rules.md docs/concepts/plugins.md --cwd ."
  },
  "devDependencies": {
    "@jondotsoy/tmd": "^0.0.9",
    "@types/bun": "latest",
    "playwright": "^1.63.0",
    "prettier": "3.7.4",
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "temporal-polyfill": "^1.0.5"
  }
}
